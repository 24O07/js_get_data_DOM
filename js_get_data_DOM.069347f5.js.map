var populationElements = document.querySelectorAll('span.population');
var populations = Array.from(populationElements).map(function(span) {
    return Number(span.textContent.replace(/,/g, ''));
});
var total = populations.reduce(function(sum, n) {
    return sum + n;
}, 0);
var average = total / populations.length;
